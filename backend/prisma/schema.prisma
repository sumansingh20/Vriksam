// ============================================================
// VRIKSHAM - Prisma Schema
// Complete database schema for the Green Infrastructure SaaS
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  ADMIN
  CLIENT
  TECHNICIAN
}

enum ClientType {
  CORPORATE
  RESIDENTIAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LocationType {
  OFFICE
  BALCONY
  LOBBY
  CAFETERIA
  TERRACE
  CORRIDOR
  CONFERENCE_ROOM
  RECEPTION
  RESTROOM
  OTHER
}

enum PlantStatus {
  HEALTHY
  NEEDS_ATTENTION
  CRITICAL
  REPLACED
  REMOVED
}

enum GrowthStage {
  SEEDLING
  JUVENILE
  MATURE
  FLOWERING
  DORMANT
}

enum LightRequirement {
  LOW
  MEDIUM
  HIGH
  DIRECT_SUNLIGHT
}

enum DifficultyLevel {
  EASY
  MODERATE
  HARD
  EXPERT
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  TRIAL
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ServiceVisitType {
  ROUTINE
  EMERGENCY
  REPLACEMENT
  INSTALLATION
  INSPECTION
}

enum ServiceVisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  BANK_TRANSFER
  CASH
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  SERVICE_REMINDER
  PAYMENT_DUE
  PLANT_ALERT
  SYSTEM
  PROMOTION
  VISIT_COMPLETED
}

// ============================================================
// Models
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  role      UserRole @default(CLIENT)
  avatar    String?
  phone     String?
  googleId  String?  @unique
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client?
  technician    Technician?
  notifications Notification[]
  healthLogs    PlantHealthLog[] @relation("TechnicianHealthLogs")

  @@index([email])
  @@index([role])
  @@index([googleId])
  @@map("users")
}

model Client {
  id                String       @id @default(uuid())
  userId            String       @unique
  companyName       String?
  industry          String?
  type              ClientType   @default(CORPORATE)
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstNumber         String?
  contactPerson     String?
  contactPhone      String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  status            ClientStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations     Location[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([city])
  @@map("clients")
}

model Location {
  id        String       @id @default(uuid())
  clientId  String
  name      String
  address   String?
  city      String?
  floor     String?
  area      Float?
  type      LocationType @default(OFFICE)
  isActive  Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plants Plant[]

  @@index([clientId])
  @@index([type])
  @@map("locations")
}

model PlantSpecies {
  id                   String           @id @default(uuid())
  commonName           String
  scientificName       String           @unique
  category             String
  lightRequirement     LightRequirement @default(MEDIUM)
  wateringFrequency    Int              @default(3)
  difficulty           DifficultyLevel  @default(MODERATE)
  airPurifyingScore    Float            @default(0)
  co2AbsorptionRate    Float            @default(0)
  oxygenProductionRate Float            @default(0)
  humidityPreference   String?
  temperatureMin       Float?
  temperatureMax       Float?
  description          String?
  careInstructions     String?
  imageUrl             String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  plants    Plant[]
  inventory Inventory[]

  @@index([commonName])
  @@index([category])
  @@index([difficulty])
  @@map("plant_species")
}

model Plant {
  id              String      @id @default(uuid())
  speciesId       String
  locationId      String
  nickname        String?
  status          PlantStatus @default(HEALTHY)
  qrCode          String?     @unique
  lastMaintenance DateTime?
  wateringCycle   Int         @default(3)
  growthStage     GrowthStage @default(MATURE)
  placedDate      DateTime    @default(now())
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  species       PlantSpecies     @relation(fields: [speciesId], references: [id])
  location      Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  healthLogs    PlantHealthLog[]
  serviceVisits ServiceVisit[]

  @@index([speciesId])
  @@index([locationId])
  @@index([status])
  @@index([qrCode])
  @@map("plants")
}

model PlantHealthLog {
  id               String   @id @default(uuid())
  plantId          String
  technicianId     String?
  healthScore      Float
  notes            String?
  diseaseDetected  String?
  imageUrl         String?
  temperature      Float?
  humidity         Float?
  soilMoisture     Float?
  lightLevel       Float?
  aiAnalysis       String?
  recommendations  String?
  createdAt        DateTime @default(now())

  plant      Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  technician User? @relation("TechnicianHealthLogs", fields: [technicianId], references: [id])

  @@index([plantId])
  @@index([technicianId])
  @@index([createdAt])
  @@map("plant_health_logs")
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  monthlyPrice   Float
  quarterlyPrice Float
  annualPrice    Float
  maxPlants      Int
  features       Json     @default("[]")
  popular        Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  clientId             String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  billingCycle         BillingCycle       @default(MONTHLY)
  stripeSubscriptionId String?            @unique
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([clientId])
  @@index([planId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model ServiceVisit {
  id              String             @id @default(uuid())
  plantId         String
  technicianId    String
  scheduledDate   DateTime
  completedDate   DateTime?
  type            ServiceVisitType   @default(ROUTINE)
  status          ServiceVisitStatus @default(SCHEDULED)
  notes           String?
  beforeImageUrl  String?
  afterImageUrl   String?
  durationMinutes Int?
  rating          Float?
  clientFeedback  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  plant      Plant      @relation(fields: [plantId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@index([plantId])
  @@index([technicianId])
  @@index([scheduledDate])
  @@index([status])
  @@map("service_visits")
}

model Technician {
  id             String   @id @default(uuid())
  userId         String   @unique
  specialization String?
  rating         Float    @default(0)
  totalVisits    Int      @default(0)
  activeZones    String[]
  availability   Json     @default("{}")
  certifications String[]
  joinedDate     DateTime @default(now())
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceVisits ServiceVisit[]
  team          Team?          @relation("TeamLead")
  teamMember    Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  teamId        String?

  @@index([userId])
  @@index([rating])
  @@index([isAvailable])
  @@map("technicians")
}

model Invoice {
  id               String        @id @default(uuid())
  subscriptionId   String?
  clientId         String
  invoiceNumber    String        @unique
  amount           Float
  tax              Float         @default(0)
  discount         Float         @default(0)
  total            Float
  status           InvoiceStatus @default(PENDING)
  dueDate          DateTime
  paidDate         DateTime?
  stripeInvoiceId  String?       @unique
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([clientId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  amount          Float
  method          PaymentMethod @default(STRIPE)
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([stripePaymentId])
  @@map("payments")
}

model Inventory {
  id            String   @id @default(uuid())
  speciesId     String
  quantity      Int      @default(0)
  cost          Float    @default(0)
  supplier      String?
  supplierPhone String?
  lastRestocked DateTime?
  minStock      Int      @default(5)
  location      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  species PlantSpecies @relation(fields: [speciesId], references: [id])

  @@index([speciesId])
  @@index([quantity])
  @@map("inventory")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  leadId      String?  @unique
  zone        String?
  memberCount Int      @default(0)
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead    Technician?  @relation("TeamLead", fields: [leadId], references: [id])
  members Technician[] @relation("TeamMembers")

  @@index([zone])
  @@map("teams")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}
