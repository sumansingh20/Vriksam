# ============================================================
# VRIKSHAM Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=Vriksham
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/vriksham?schema=public

# ------------------------------------------------------------
# MongoDB (Mongoose - Dual Database Option)
# ------------------------------------------------------------
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vriksham?retryWrites=true&w=majority
# For local development:
# MONGODB_URI=mongodb://localhost:27017/vriksham

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ------------------------------------------------------------
# Stripe Payments
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ------------------------------------------------------------
# OpenAI (Plant Health AI)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# ------------------------------------------------------------
# AWS S3 (File Uploads)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vriksham-uploads

# ------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@vriksham.com

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_DIR=logs

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Image Processing
# ------------------------------------------------------------
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200
