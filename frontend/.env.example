# =============================================================================
# VRIKSHAM - Green Infrastructure SaaS Platform
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Vriksham"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
API_SECRET_KEY=your_api_secret_key_here

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/vriksham?schema=public

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_ID_STARTER=price_starter_id_here
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_id_here
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_id_here

# -----------------------------------------------------------------------------
# File Storage (S3-compatible)
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=vriksham-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key_here
S3_SECRET_ACCESS_KEY=your_s3_secret_key_here
S3_ENDPOINT=https://s3.amazonaws.com
NEXT_PUBLIC_CDN_URL=https://cdn.vriksham.com

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="Vriksham <noreply@vriksham.com>"

# -----------------------------------------------------------------------------
# Redis (Caching & Sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=your_redis_token_here

# -----------------------------------------------------------------------------
# Maps & Geolocation
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# -----------------------------------------------------------------------------
# AI / ML Services
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_AI_FEATURES_ENABLED=true

# -----------------------------------------------------------------------------
# IoT / Sensor Integration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MQTT_BROKER_URL=wss://mqtt.vriksham.com:8884
MQTT_USERNAME=your_mqtt_username_here
MQTT_PASSWORD=your_mqtt_password_here

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_3D_VISUALIZATION=true
NEXT_PUBLIC_ENABLE_REAL_TIME_MONITORING=true
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=true
NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
